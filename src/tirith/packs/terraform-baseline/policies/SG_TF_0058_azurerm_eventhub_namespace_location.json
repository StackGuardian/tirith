  "evaluators": [
    {
      "id": "eventhub_namespace_in_zone_redundant_region",
      "description": "Zone redundancy for Event Hub namespaces is decided by the region, so the location attribute is tested for membership of the zone-redundant list. The list carries both the display form ('West Europe') and the normalised slug ('westeurope'), so it matches whichever spelling the plan records. A namespace with no location in change.after is a severity-2 miss and fails at error_tolerance 1.",
      "provider_args": {
        "operation_type": "attribute",
        "terraform_resource_type": "azurerm_eventhub_namespace",
        "terraform_resource_attribute": "location"
      },
