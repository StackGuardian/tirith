[
  {
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
      "name": "api",
      "namespace": "production"
    },
    "spec": {
      "containers": [
        {
          "name": "api",
          "image": "acme/api:1.4.2",
          "livenessProbe": {
            "httpGet": { "path": "/healthz", "port": 8080 },
            "initialDelaySeconds": 10
          }
        },
        {
          "name": "sidecar",
          "image": "acme/log-shipper:latest"
        }
      ]
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "api",
      "namespace": "production"
    },
    "spec": {
      "selector": { "app": "api" },
      "ports": [{ "port": 80, "targetPort": 8080 }]
    }
  }
]
