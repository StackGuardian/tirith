      "change": {
        "actions": [
          "create"
        ],
        "before": null,
        "after": {
          "instance_type": "t3.small",
          "tags": {
            "Owner": "platform-team",
            "Name": "acme",
            "Environment": "prod"
          },
          "user_data": "#!/bin/bash\nsystemctl start app\n"
        }
      }
    }
  ],
  "configuration": {
    "provider_config": {
      "aws": {
        "name": "aws",
        "full_name": "registry.terraform.io/hashicorp/aws",
        "version_constraint": "~> 5.0",
        "expressions": {
